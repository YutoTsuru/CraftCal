# Supabase の接続情報。値は Supabase ダッシュボードの Project Settings > API から取得する。
# このファイルは雛形なので実際の値は書かず、コピーして .env.local に設定する（.env.local は gitignore 済み）。

# プロジェクトの URL（例: https://xxxxxxxx.supabase.co）
NEXT_PUBLIC_SUPABASE_URL=

# ブラウザから使う公開可能キー（Publishable / anon key）。Secret・Service Role キーは絶対に置かない。
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
